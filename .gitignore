.venv/
__pycache__/
*.py[cod]
.pytest_cache/
out/

# Kaggle staging and fetched outputs. Rebuilt by kaggle/push.py; never committed.
kaggle/_build/
kaggle/_output/
bench/results/
bench/plots/

# Kaggle API credentials. The real token lives at ~/.kaggle/kaggle.json, outside
# this repo, so these patterns exist to catch a stray copy landing inside it. A
# leaked token is an account takeover, so the guard is belt and braces:
# tests/test_kaggle_session.py asserts git tracks no credential file.
kaggle.json
.kaggle/
**/kaggle.json
*credentials*.json
