.venv/
__pycache__/
*.py[cod]
.pytest_cache/
out/

# Kaggle staging and fetched outputs. Rebuilt by kaggle/push.py; never committed.
kaggle/_build/
kaggle/_output/
bench/results/
bench/plots/

# Kaggle API credentials. The real token lives at ~/.kaggle/kaggle.json, outside
# this repo, so these patterns exist to catch a stray copy landing inside it. A
# leaked token is an account takeover, so the guard is belt and braces:
# tests/test_kaggle_session.py asserts git tracks no credential file.
kaggle.json
.kaggle/
**/kaggle.json
*credentials*.json

# graphify: the graph and rendered outputs are committed so agents can use them.
# The extraction cache is machine-local and rebuilt on demand.
graphify-out/cache/
graphify-out/.graphify_*

# Credential shapes. None has ever been tracked -- history was scanned before
# the first push and contains no PEM block, no {"username","key"} pair and no
# 32-hex literal, which is a Kaggle API key's exact shape. These are here so
# that stays true by construction rather than by having been checked once.
.env
.env.*
*.pem
*.key
*.p12
id_rsa*
.netrc
.htpasswd
credentials.json
service-account*.json

# Stale snapshot of the source tree, produced by a Kaggle output download and
# committed by accident in c666068. 27 files, 400 KB, and already diverged from
# the real tree -- an old engine/attention.py sitting next to the current one is
# worse than no copy at all.
/repo/

# Kaggle run debris that reached the repo root. c.txt is the one-line pip
# constraint file each kernel writes; session4_report.json was a byte-identical
# duplicate of kaggle/session4/session4_report.json. Both were the first two
# things visible in a bare `ls` of the repo.
/c.txt
/session*_report.json

# The batch-order results are CITED BY THE README, so they ship. Everything
# else under bench/results/ is scratch output and stays ignored.
!bench/results/batch-order/
!bench/results/batch-order/**
